---
import ImageMod from "@/components/ImageMod.astro";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import PageHeader from "@/partials/PageHeader.astro";
import PlaybookSidebar from "@/partials/PlaybookSidebar.astro";
import { render, type CollectionEntry } from "astro:content";

type Props = {
  playbook: CollectionEntry<"playbooks">;
};

const COLLECTION_FOLDER = "playbooks";
export async function getStaticPaths() {
  const COLLECTION_FOLDER = "playbooks";
  const playbooksCollection = await getSinglePage(COLLECTION_FOLDER);

  const paths = playbooksCollection.map((playbook) => ({
    params: {
      single: playbook.id,
    },
    props: { playbook: playbook },
  }));
  return paths;
}

const { playbook } = Astro.props;
const { title, meta_title, description, image, bg_image } = playbook.data;

const { Content } = await render(playbook);
const playbooksCollection = await getSinglePage(COLLECTION_FOLDER);
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}>
  <PageHeader title={title} bg_image={bg_image} />

  <section class="section">
    <div class="container">
      <div class="row gy-4">
        <PlaybookSidebar
          content={playbook}
          playbooksCollection={playbooksCollection}
        />
        <article class="lg:col-8 lg:order-2 order-1">
          {
            image && (
              <ImageMod
                src={image}
                width={900}
                height={500}
                class="w-full mb-8 md:mb-16 rounded-t-md"
                alt="service"
              />
            )
          }
          {
            playbook.body && (
              <div class="content">
                <Content />
              </div>
            )
          }
        </article>
      </div>
    </div>
  </section>
</Base>
